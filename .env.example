# Copie para .env se quiser mudar algo (tudo é opcional).

# Como as mensagens de vocês aparecem nos arquivos (você e a Vivian juntos)
NOME_ATENDENTE=Suporte

# Só guarda mensagens a partir desta data (dd/mm/aaaa). Vazio = guarda tudo que vier.
GUARDAR_DESDE=

# Tempo gasto: intervalos maiores que isso (minutos) não contam
PAUSA_MIN=30

# Conversa parada por mais que isso (horas) fecha o chamado
NOVO_HORAS=4
